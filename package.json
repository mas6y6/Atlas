{
  "name": "atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter client --filter server dev",
    "dev:client": "bun run --filter client dev",
    "dev:server": "bun run --filter server dev",
